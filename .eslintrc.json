{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.js"],
      "env": { "node": true, "browser": false }
    },
    {
      "files": ["__tests__/**/*.js"],
      "env": { "node": true, "jest": true }
    }
  ]
}
